# 1. Contact Form (Nodemailer / Gmail SMTP)
# EMAIL_USER: Your authenticated Gmail address used as the SMTP sender
EMAIL_USER=vinayaksharma4777@gmail.com

# EMAIL_PASS: Google App Password generated from https://myaccount.google.com/apppasswords
# (Note: Do NOT use your standard Google account password. Generate a 16-character App Password)
EMAIL_PASS=your_google_app_password_here

# CONTACT_RECEIVER_EMAIL: The inbox where incoming contact form messages are delivered
CONTACT_RECEIVER_EMAIL=vinayaksharma4777@gmail.com

# 2. GitHub Activity Widget
GITHUB_USERNAME=vinayaksharma403
